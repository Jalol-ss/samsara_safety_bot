# ============================================================
# Samsara Safety Bot — environment variables
# ============================================================

# Telegram ----------------------------------------------------
# BotFather bot token for THIS bot (separate from the PM bot).
BOT_TOKEN_SAFETY=

# Supergroup where safety alerts land. The chat must have
# "Topics" enabled (Group settings → Topics → ON).
SAFETY_GROUP_CHAT_ID=

# Samsara -----------------------------------------------------
# Same org token as the PM bot — reuses "Read Safety Events
# & Scores" scope. If this scope isn't on the token, add it in
# Samsara dashboard: Settings → API Tokens → edit → Safety &
# Cameras → Read Safety Events & Scores.
SAMSARA_API_TOKEN=

# Webhook mode (preferred) ------------------------------------
# Public HTTPS URL where Samsara will POST events. Must match
# EXACTLY what you register in Samsara dashboard. On Railway
# this is: https://<service>.up.railway.app/webhook/samsara
PUBLIC_BASE_URL=

# Optional shared-secret used to verify Samsara signatures on
# every incoming webhook. Register the same value when you
# create the webhook in Samsara's dashboard.
SAMSARA_WEBHOOK_SECRET=

# Port the aiohttp web server listens on. Railway sets $PORT
# automatically; locally default to 8080.
PORT=8080

# Polling mode (fallback if webhooks unavailable) -------------
# Set to "1" to enable the fallback poller. It pings
# /fleet/safety-events every POLL_INTERVAL_SECONDS and sends
# any newly-seen events to Telegram. Harmless to leave on
# alongside webhooks (dedup is by event_id).
ENABLE_SAFETY_POLLER=0
POLL_INTERVAL_SECONDS=60

# Event scope -------------------------------------------------
# Comma-separated list of Samsara event types to forward. Keep
# empty to forward everything. Known labels:
#   HarshBrake HarshTurn HarshAcceleration Crash
#   NearCollision FollowingDistance RollingStop
#   RanRedLight SevereSpeeding DistractedDriving
#   NoSeatbelt PassengerDetected PedestrianCollisionWarning
SAFETY_EVENT_TYPES=

# Dashcam video attach ---------------------------------------
# Try to attach dashcam clip to each alert. Set 0 to only send
# the text + photo. If the event payload already has a
# mediaUrl we always use that; this flag controls whether we
# ALSO fire a /cameras/media/retrieval if media is missing.
ATTACH_DASHCAM_VIDEO=1
VIDEO_LOOKBACK_SECONDS=15
VIDEO_LOOKAHEAD_SECONDS=15
VIDEO_POLL_SECONDS=90

# Logging -----------------------------------------------------
LOG_LEVEL=INFO
